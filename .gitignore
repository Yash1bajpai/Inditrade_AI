# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env
*.env
.env.local
.env.*.local
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Log files
*.log
logs/*
!logs/.gitkeep

# Data & cache directories (preserve structure only)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/flagged_trade_anomalies.csv
!data/processed/node2vec_trade_embeddings.parquet
data/cache/*
!data/cache/.gitkeep
!data/cache/*_meta.json
!data/cache/bm25_index.pkl.lzma

# Models directory (preserve structure and metadata json only)
models/*.pkl
models/*.onnx
models/*.bin
!models/*_meta.json
!models/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.cover
.mypy_cache/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDEs & OS artifacts
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Build & Distribution
dist/
build/
*.egg-info/

# Context & Handoff
CONTEXT_HANDOFF.md
context_handoff.md

# Graph Memory & Local Agent Storage
.agents/
*.sqlite
*.html

# Scratch and Temp Dirs
scratch/
.scan_tmp/
.scannerwork/
.sonar/
reports/*
!reports/rag_eval_*.json
notebooks/

# Model Checkpoints and LLM outputs
models/llm_output/
*.safetensors
*.pt
*.pth
*.bin

# Personal Agent Tools
src/utils/*graph*.py
graph_summary.txt

# Local scratch copies of reference docs (e.g. ref_readme.md.bak)
*.bak

# IDE junk
.qoder/
kaggle_output/
